# Copy this file to .env and fill in your key:
#   cp .env.example .env

# Required — the default model (OpenAI gpt-5.6-sol) needs this.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional — LangSmith tracing. Leave TRACING=false if you don't have an
# account; every lab in this folder runs fine without it.
# Get a key at https://smith.langchain.com/  (Settings -> API Keys)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ch11-agent-harnesses
